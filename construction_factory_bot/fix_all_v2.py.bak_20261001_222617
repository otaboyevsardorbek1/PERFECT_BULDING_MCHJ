import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).parent.resolve()
STAMP = datetime.now().strftime("%Y%m%d_%H%M%S")
BACKUP = ROOT / f".fix_backup_v2_{STAMP}"


# ============================================================
# YORDAMCHILAR
# ============================================================

def check_project():
    required = ["config.py", "main.py", "utils", "dashboard"]
    missing = [r for r in required if not (ROOT / r).exists()]
    if missing:
        sys.exit(f"❌ Loyiha ildizida emasmiz. Yetishmayapti: {missing}")


def backup_file(path: Path) -> bool:
    if not path.exists():
        return False
    rel = path.relative_to(ROOT)
    bp = BACKUP / rel
    bp.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(path, bp)
    return True


def patch(path: Path, old: str, new: str, label: str) -> bool:
    if not path.exists():
        print(f"   ⚠️  [{label}] Fayl topilmadi: {path.relative_to(ROOT)}")
        return False
    txt = path.read_text(encoding="utf-8")
    if old not in txt:
        print(f"   ⚠️  [{label}] Matn topilmadi — o'tkazib yuborildi")
        return False
    backup_file(path)
    path.write_text(txt.replace(old, new, 1), encoding="utf-8")
    print(f"   ✅ [{label}]")
    return True


def write_new(path: Path, content: str, label: str) -> bool:
    if path.exists():
        print(f"   ⚠️  [{label}] Fayl mavjud — o'tkazib yuborildi: {path.relative_to(ROOT)}")
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    print(f"   ✅ [{label}]")
    return True


def run(cmd, check=False):
    print(f"\n$ {' '.join(cmd)}")
    return subprocess.run(cmd, cwd=ROOT, check=False)


