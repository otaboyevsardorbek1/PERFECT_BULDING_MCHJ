# =============== BOT TOKEN ===============
# @BotFather dan olingan bot tokeni
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ123456789

# =============== ADMINLAR ===============
# Adminlar Telegram ID lari (vergul bilan ajratilgan)
ADMIN_IDS=123456789,987654321
# Asosiy admin ID si
MAIN_ADMIN_ID=123456789

# =============== DATABASE ===============
# PostgreSQL foydalanish (true/false)
USE_POSTGRESQL=false

# PostgreSQL sozlamalari (agar USE_POSTGRESQL=true bo'lsa)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=construction_factory
DB_USER=postgres
DB_PASSWORD=your_password

# =============== SMS SOZLAMALARI ===============
# Eskiz.uz SMS xizmati
# Ro'yxatdan o'tish: https://eskiz.uz
# API kalit olish: https://my.eskiz.uz -> API bo'limi
SMS_API_KEY=your_eskiz_api_key_here
SMS_SENDER=KORXONA
SMS_ENABLED=true

# =============== EMAIL SOZLAMALARI ===============
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Telegram kanal/guruh
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_GROUP_ID=-1001234567890

# =============== WEB DASHBOARD AUTH (v3) ===============
# Tokenlarni imzolash uchun maxfiy kalit.
# Berilmasa, avtomatik yaratilib .web_secret faylida saqlanadi (repo'ga kirmaydi).
API_SECRET_KEY=your_secret_api_key
# Access token amal qilish muddati (soat)
TOKEN_TTL_HOURS=12
# Refresh token amal qilish muddati (kun) — har refresh'da sliding: muddat uzayadi
REFRESH_TOKEN_TTL_DAYS=30
# Parol tiklash kodining amal qilish muddati (soat) — admin tasdiqlagach
RESET_CODE_TTL_HOURS=2
# Birinchi ishga tushirishda paroli yo'q ADMIN xodimlarga o'rnatiladigan parol
# (ixtiyoriy — parol CLI orqali ham o'rnatiladi: python -m dashboard.auth set-password)
WEB_ADMIN_PASSWORD=
# Web parol minimal uzunligi (default: 8)
WEB_PASSWORD_MIN_LENGTH=8

# =============== ONLAYN TO'LOVLAR (Click / Payme) ===============
# Click: https://my.click.uz kabineti -> Service ID va Secret key (SHOP API ulangan bo'lishi kerak)
# Click kabinetida webhook manzil sifatida https://<domen>/api/payments/click beriladi
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SERVICE_ID=your_click_service_id
CLICK_SECRET_KEY=your_click_secret_key

# Payme: Payme Business kabineti -> Merchant (cashbox) ID va kalit (parol)
# Payme kabinetida callback manzil sifatida https://<domen>/api/payments/payme beriladi
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_KEY=your_payme_key

# Mijoz to'lovdan keyin qaytadigan sahifa (ixtiyoriy, masalan web dashboard)
PAYMENT_RETURN_URL=

# =============== QAYTARISH AKTI (RETURN) ===============
# Mijoz tovarni necha kun ichida qaytarishi mumkin (TZ bo'yicha: 7 kun)
RETURN_PERIOD_DAYS=7

# =============== NASIYA QARZ ESLATMALARI (SMS) ===============
# Muddati o'tgan qarz uchun SMS eslatma kunlari (vergul bilan). SMS_ENABLED=true bo'lishi kerak.
DEBT_REMINDER_DAYS=3,7,14,30

# Sekin sotiladigan zaxira: tovar/xom ashyo necha kun harakatlanmasa ogohlantirish
SLOW_STOCK_DAYS=30

# =============== WEB (NODE.JS FRONTEND) ===============
# Node.js web server porti
WEB_PORT=3000
# Node.js dan Python API ga yo'naltirish
PYTHON_API_URL=http://127.0.0.1:8000
# CORS uchun ruxsat etilgan originlar
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============== AVTOMATIK BACKUP ===============
# Database zaxira nusxasi har kuni BACKUP_TIME da olinadi (fon vazifasi orqali)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily        # daily | weekly (dushanba) | monthly (oyning 1-kuni)
BACKUP_TIME=02:00            # HH:MM — ish vaqti tugagach, kam yuklanish payti
BACKUP_KEEP_DAYS=30          # necha kunlik nusxalar saqlanadi (eskisi o'chadi)
BACKUP_NOTIFY=true           # backupdan so'ng adminlarga Telegram xabar

# =============== BACKUPNI UZOQ JOYGA YUKLASH ===============
# Har bir backup faylni uzoq joyda xavfsiz saqlash (serverda muammo bo'lsa ham nusxa tashqarida)
# Bir nechta manzilga ham yuborish mumkin: telegram,s3
BACKUP_UPLOAD=none           # none | telegram | s3 | telegram,s3

# Uzoq joydagi nusxalar necha kun saqlanadi (eski uzoq nusxalar avtomatik o'chiriladi).
# 0 bo'lsa uzoq joyda tozalash o'chadi; bo'sh qoldirilsa BACKUP_KEEP_DAYS ishlatiladi.
BACKUP_REMOTE_KEEP_DAYS=30

# Telegram: kanal @nomi yoki ID si (bot kanalga admin qo'shilgan bo'lishi kerak).
# TELEGRAM_CHANNEL_ID dan alohida — faqat backup fayllar uchun shaxsiy kanal tavsiya etiladi.
BACKUP_TELEGRAM_CHANNEL_ID=-1001234567890

# S3-mos bulut (AWS S3, MinIO, Wasabi, DigitalOcean Spaces, Yandex Cloud...)
# MinIO uchun masalan: BACKUP_S3_ENDPOINT=http://localhost:9000
BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=my-company-backups
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key
BACKUP_S3_PREFIX=backups     # bucket ichidagi papka (masalan backups/2026/09/...)

# =============== BACKUP SHIFRLASH (chiquvchi nusxalar) ===============
# Parol qo'yilsa SERVERDAN CHIQADIGAN har bir backup shifrlanadi (PBKDF2-200k + AES)
# va .enc sifatida Telegram/S3 ga yuklanadi. Lokal nusxa (backups/) ochiq qoladi.
# Shifrni ochish: python -c "from utils.backup import decrypt_backup_file; ..."
BACKUP_ENCRYPTION_PASSWORD=your_strong_backup_password

# =============== MIJOZ TRIAJI (Oltin/Kumush/Bronza) ===============
# Mijoz segmentatsiya chegaralari (so'm):
#   Oltin  — jami xarid >= CUSTOMER_TIER_GOLD_THRESHOLD (va qarz xaridning 50% dan oshmagan)
#   Kumush — jami xarid >= CUSTOMER_TIER_SILVER_THRESHOLD
#   Bronza — qolganlar; muddati o'tgan qarzi borlar ham Bronza
CUSTOMER_TIER_GOLD_THRESHOLD=50000000
CUSTOMER_TIER_SILVER_THRESHOLD=10000000

# =============== TIZIM ===============
# Debug rejimi
DEBUG_MODE=false

# Test rejimi
TEST_MODE=false

# Til
LANGUAGE=uz

# Valyuta
CURRENCY=UZS
